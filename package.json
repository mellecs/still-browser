{
  "name": "chorus-browser",
  "version": "2.2.0",
  "description": "Still Browser",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:linux": "electron-builder --linux AppImage --publish never"
  },
  "keywords": [],
  "author": "Still Browser",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "electron-chrome-extensions": "^4.9.0",
    "electron-chrome-web-store": "^0.13.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.chorus.browser",
    "productName": "Still Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!extensions-off/**",
      "!dist/**",
      "!**/*.antes-*",
      "!**/*.bak",
      "!**/*.con-*",
      "!**/*.off",
      "!salida.txt",
      "!*.log",
      "!dist-log.txt"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mellecs",
        "repo": "still-browser"
      }
    ],
    "nsis": {
      "artifactName": "Still-Browser-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Network;WebBrowser",
      "artifactName": "Still-Browser-${version}.AppImage"
    }
  },
  "productName": "Still Browser"
}
